generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// docs/02-architecture.md §4.1 — needed because the app is deployed publicly,
// even though there's exactly one real account.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  guild     String?  @default("Adventurer")
  createdAt DateTime @default(now()) @map("created_at")

  bonusXp    Int @default(0) @map("bonus_xp")
  bonusCoins Int @default(0) @map("bonus_coins")

  purchasedDecorations String[] @default([]) @map("purchased_decorations")
  placedDecorations    Json     @default("{}") @map("placed_decorations")

  settings             Json     @default("[{\"key\":\"notifications\",\"label\":\"Notifications\",\"description\":\"Overdue and sprint deadline alerts\",\"type\":\"boolean\",\"value\":true},{\"key\":\"soundEnabled\",\"label\":\"Sound Effects\",\"description\":\"Subtle chimes on task complete and level-up\",\"type\":\"boolean\",\"value\":true},{\"key\":\"reduceMotion\",\"label\":\"Reduce Motion\",\"description\":\"Shortens all animation durations\",\"type\":\"boolean\",\"value\":false},{\"key\":\"defaultView\",\"label\":\"Default View\",\"description\":\"Screen shown on app open\",\"type\":\"select\",\"options\":[\"dashboard\",\"today\",\"focus\",\"kanban\"],\"value\":\"dashboard\"},{\"key\":\"focusMinutes\",\"label\":\"Focus Duration\",\"description\":\"Minutes per focus interval\",\"type\":\"number\",\"value\":25},{\"key\":\"breakMinutes\",\"label\":\"Break Duration\",\"description\":\"Minutes per break interval\",\"type\":\"number\",\"value\":5}]")

  savedFilters         Json     @default("[]") @map("saved_filters")
  lastQuestClaimedAt   DateTime? @map("last_quest_claimed_at")

  activeTimerTaskId    String?   @map("active_timer_task_id") @db.Uuid
  activeTimerStartedAt DateTime? @map("active_timer_started_at")
  activeTimerPhase     String    @default("focus") @map("active_timer_phase")

  tasks        Task[]
  comments     Comment[]
  activityLogs ActivityLog[]
  notes        Note[]

  @@map("users")
}

enum TaskStatus {
  inbox
  todo
  ready
  in_progress
  blocked
  waiting_external
  testing
  done
  archived

  @@map("task_status")
}

enum TaskType {
  coding
  investigation
  study
  analysis
  documentation
  bug
  deployment
  testing
  meeting
  research
  design
  maintenance
  refactor
  incident
  communication

  @@map("task_type")
}

enum TaskPriority {
  p0
  p1
  p2
  p3
  p4

  @@map("task_priority")
}

enum TaskEffort {
  xs
  s
  m
  l
  xl
  xxl

  @@map("task_effort")
}

enum TaskReporter {
  self
  qa
  manager
  pm
  client
  lecturer
  friend
  other

  @@map("task_reporter")
}

// docs/02-architecture.md §4.4 — the core table.
model Task {
  id          String  @id @default(uuid()) @db.Uuid
  code        String? @map("code")
  title       String
  description String?

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sprintId  String?  @map("sprint_id") @db.Uuid
  sprint    Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  status   TaskStatus
  type     TaskType
  priority TaskPriority
  effort   TaskEffort?

  storyPoint Int? @map("story_point")

  // Defaults to `self` — docs/01-product.md §8.8.
  reporter TaskReporter @default(self)

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id])

  startDate DateTime? @map("start_date") @db.Date
  dueDate   DateTime? @map("due_date") @db.Date

  tags         String[]
  relations    Json     @default("[]")
  attachments  Json     @default("[]")
  deliverables Json     @default("[]")

  timeSpentSeconds Int @default(0) @map("time_spent_seconds")
  pinned           Boolean @default(false)

  completedAt DateTime? @map("completed_at")
  archivedAt  DateTime? @map("archived_at")
  deletedAt   DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statusHistory TaskStatusLog[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  workSessions  WorkSession[]
  noteLinks     NoteTaskLink[]

  @@unique([ownerId, code])
  @@index([status])
  @@index([projectId])
  @@index([dueDate])
  @@index([ownerId])
  @@index([ownerId, status])
  @@index([ownerId, deletedAt])
  @@map("tasks")
}

enum ProjectCategory {
  FullTime    @map("Full-time")
  University
  SideProject @map("Side Project")
  Freelance
  Personal
  Other

  @@map("project_category")
}

enum ProjectStatus {
  active
  on_hold
  completed

  @@map("project_status")
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  code        String?         @unique @map("code")
  name        String
  category    ProjectCategory
  colorVar    String          @map("color_var")
  customColor String?         @map("custom_color")
  emoji       String
  description String?
  status      ProjectStatus   @default(active)

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tasks        Task[]
  sprints      Sprint[]
  activityLogs ActivityLog[]

  @@map("projects")
}

enum SprintStatus {
  planning
  active
  completed

  @@map("sprint_status")
}

model Sprint {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  projectId String       @map("project_id") @db.Uuid
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    SprintStatus @default(planning)
  goal      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks        Task[]
  activityLogs ActivityLog[]

  @@map("sprints")
}

model TaskStatusLog {
  id         String     @id @default(uuid()) @db.Uuid
  taskId     String     @map("task_id") @db.Uuid
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus TaskStatus? @map("from_status")
  toStatus   TaskStatus  @map("to_status")
  changedAt  DateTime   @default(now()) @map("changed_at")

  @@map("task_status_logs")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sprintId  String?  @map("sprint_id") @db.Uuid
  sprint    Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  actorId   String   @map("actor_id") @db.Uuid
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@map("activity_logs")
}

model WorkSession {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt       DateTime @map("started_at")
  endedAt         DateTime @map("ended_at")
  durationSeconds Int      @map("duration_seconds")

  @@map("work_sessions")
}

model Note {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  content   String   @db.Text
  tags      String[] @default([])
  pinned    Boolean  @default(false)

  attachments NoteAttachment[]
  taskLinks   NoteTaskLink[]
  linksAsA    NoteLink[]       @relation("NoteLinkA")
  linksAsB    NoteLink[]       @relation("NoteLinkB")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, pinned])
  @@index([createdAt])
  @@map("notes")
}

model NoteAttachment {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  url       String
  fileName  String   @map("file_name")
  fileType  String?  @map("file_type")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([noteId])
  @@map("note_attachments")
}

model NoteTaskLink {
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([noteId, taskId])
  @@index([taskId])
  @@map("note_task_links")
}

/**
 * Note-to-note linking — docs/01-product.md §14, the one piece of the original Notes idea
 * that wasn't built alongside the rest (docs/05-backlog.md EPIC-28). Undirected: one row per
 * pair, stored with noteAId as the lexicographically smaller id so a pair is never inserted
 * twice in either direction — enforced at the application layer, not by a DB constraint.
 */
model NoteLink {
  id      String @id @default(cuid())
  noteAId String
  noteA   Note   @relation("NoteLinkA", fields: [noteAId], references: [id], onDelete: Cascade)
  noteBId String
  noteB   Note   @relation("NoteLinkB", fields: [noteBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([noteAId, noteBId])
  @@index([noteBId])
  @@map("note_links")
}

