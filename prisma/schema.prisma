generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  guild     String?  @default("Adventurer")
  createdAt DateTime @default(now()) @map("created_at")

  bonusXp    Int @default(0) @map("bonus_xp")
  bonusCoins Int @default(0) @map("bonus_coins")

  purchasedDecorations String[] @default([]) @map("purchased_decorations")
  placedDecorations    Json     @default("{}") @map("placed_decorations")

  savedFilters       Json      @default("[]") @map("saved_filters")
  lastQuestClaimedAt DateTime? @map("last_quest_claimed_at")

  activeTimerTaskId    String?   @map("active_timer_task_id") @db.Uuid
  activeTimerStartedAt DateTime? @map("active_timer_started_at")
  activeTimerPhase     String    @default("focus") @map("active_timer_phase")

  tasks        Task[]
  projects     Project[]
  comments     Comment[]
  activityLogs ActivityLog[]
  xpLogs       XpLog[]
  settings     Setting[]

  @@map("users")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@map("settings")
}

enum TaskStatus {
  backlog
  todo
  in_progress
  done
  archived

  @@map("task_status")
}

enum TaskType {
  coding
  research
  design
  documentation
  bug
  meeting
  admin

  @@map("task_type")
}

enum TaskPriority {
  high
  medium
  low

  @@map("task_priority")
}

enum TaskSize {
  xs
  s
  m
  l
  xl

  @@map("task_size")
}

enum TaskReporter {
  self
  other

  @@map("task_reporter")
}

enum ProjectCategory {
  work
  personal
  learning
  other

  @@map("project_category")
}

enum ProjectStatus {
  active
  completed
  archived

  @@map("project_status")
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  code        String?         @unique @map("code")
  name        String
  category    ProjectCategory
  colorVar    String          @map("color_var")
  customColor String?         @map("custom_color")
  emoji       String
  description String?
  status      ProjectStatus   @default(active)

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tasks        Task[]
  activityLogs ActivityLog[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@map("projects")
}

model TaskStatusLog {
  id         String      @id @default(uuid()) @db.Uuid
  taskId     String      @map("task_id") @db.Uuid
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus TaskStatus? @map("from_status")
  toStatus   TaskStatus  @map("to_status")
  changedAt  DateTime    @default(now()) @map("changed_at")

  @@index([taskId])
  @@map("task_status_logs")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model Attachment {
  id        String          @id @default(uuid()) @db.Uuid
  taskId    String          @map("task_id") @db.Uuid
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      AttachmentType
  url       String
  label     String?
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([taskId])
  @@map("attachments")
}

enum AttachmentType {
  github_pr
  github_issue
  link
  file
  other

  @@map("attachment_type")
}

model Deliverable {
  id            String            @id @default(uuid()) @db.Uuid
  taskId        String            @map("task_id") @db.Uuid
  task          Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type          DeliverableType
  urlOrContent  String            @map("url_or_content")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([taskId])
  @@map("deliverables")
}

enum DeliverableType {
  pr
  doc
  design
  other

  @@map("deliverable_type")
}

model TaskRelation {
  id             String            @id @default(uuid()) @db.Uuid
  taskId         String            @map("task_id") @db.Uuid
  task           Task              @relation("TaskRelations", fields: [taskId], references: [id], onDelete: Cascade)
  relatedTaskId  String            @map("related_task_id") @db.Uuid
  relatedTask    Task              @relation("RelatedTaskRelations", fields: [relatedTaskId], references: [id], onDelete: Cascade)
  relationType   TaskRelationType  @map("relation_type")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([taskId, relatedTaskId, relationType])
  @@index([relatedTaskId])
  @@map("task_relations")
}

enum TaskRelationType {
  blocks
  relates_to
  duplicates

  @@map("task_relation_type")
}

model XpLog {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([taskId])
  @@map("xp_logs")
}

model Achievement {
  id          String            @id @default(uuid()) @db.Uuid
  key         String            @unique
  name        String
  description String
  icon        String
  category    AchievementCategory
  unlockedAt  DateTime?         @map("unlocked_at")

  @@map("achievements")
}

enum AchievementCategory {
  combat
  exploration
  crafting
  social

  @@map("achievement_category")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actorId   String   @map("actor_id") @db.Uuid
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([taskId])
  @@index([projectId])
  @@map("activity_logs")
}

model WorkSession {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt       DateTime @map("started_at")
  endedAt         DateTime @map("ended_at")
  durationSeconds Int      @map("duration_seconds")

  @@index([taskId])
  @@map("work_sessions")
}

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  code        String? @map("code")
  title       String
  description String?

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  status   TaskStatus
  type     TaskType
  priority TaskPriority
  size     TaskSize?

  reporter TaskReporter @default(self)

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id])

  startDate DateTime? @map("start_date") @db.Date
  dueDate   DateTime? @map("due_date") @db.Date

  tags         TaskTag[]
  relations    TaskRelation[] @relation("TaskRelations")
  relatedTasks TaskRelation[] @relation("RelatedTaskRelations")
  attachments  Attachment[]
  deliverables Deliverable[]

  timeSpentSeconds Int     @default(0) @map("time_spent_seconds")
  pinned           Boolean @default(false)

  completedAt DateTime? @map("completed_at")
  archivedAt  DateTime? @map("archived_at")
  deletedAt   DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statusHistory TaskStatusLog[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  workSessions  WorkSession[]
  xpLogs        XpLog[]

  @@unique([ownerId, code])
  @@index([status])
  @@index([projectId])
  @@index([dueDate])
  @@index([ownerId])
  @@index([ownerId, status])
  @@index([ownerId, deletedAt])
  @@index([ownerId, deletedAt, status])
  @@index([ownerId, deletedAt, createdAt])
  @@map("tasks")
}