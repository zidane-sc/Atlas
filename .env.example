# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers) — callback URL: <origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Only these emails may sign in — comma-separated (docs/02-architecture.md §6)
ALLOWED_EMAIL=zidankren02@gmail.com,other@example.com

# Neon Postgres (console.neon.tech → project → Connection Details)
# Pooled — used by the app at runtime (host has a "-pooler" suffix).
DATABASE_URL="postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct — used by the Prisma CLI for migrations (no "-pooler").
DIRECT_URL="postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
