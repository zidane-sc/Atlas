// ─── GAMIFICATION FORMULAS (design.md §11) ───────────────────

function xpForLevel(n: number): number {
  return Math.round((100 * Math.pow(n, 1.5)) / 10) * 10;
}

function getLevelInfo(totalXP: number): { level: number; currentXP: number; nextLevelXP: number } {
  let cumulative = 0;
  let level = 1;
  while (true) {
    const needed = xpForLevel(level);
    if (cumulative + needed > totalXP) return { level, currentXP: totalXP - cumulative, nextLevelXP: needed };
    cumulative += needed;
    level++;
  }
}

function calcTaskXP(priority: Priority, storyPoints: number, onTime: boolean): number {
  const base = PRIORITY_CFG[priority].xpBase + storyPoints * 10;
  return Math.round(base * (onTime ? 1.2 : 1.0));
}

function calcCoins(priority: Priority, storyPoints: number): number {
  return storyPoints + PRIORITY_CFG[priority].coin;
}

function streakEmoji(days: number): { icon: string; label: string } {
  if (days >= 30) return { icon: "🔥🔥", label: "Blaze" };
  if (days >= 14) return { icon: "🏕️",   label: "Bonfire" };
  if (days >= 7)  return { icon: "🔥",    label: "Steady Fire" };
  if (days >= 3)  return { icon: "🕯️",   label: "Small Flame" };
  return             { icon: "✨",   label: "Spark" };
}

